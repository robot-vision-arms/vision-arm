<?xml version="1.0"?>
<!--
  ur_simulation_gz 의 기본 로봇(ur_gz.urdf.xacro)에 흡착 패드와 DetachableJoint 슬롯만 덧붙인다.
  sim.launch.py 가 ur_sim_control.launch.py 의 description_file 로 이 파일을 넘긴다.
  ur_type 등 xacro 인자는 포함한 파일이 그대로 받는다.

  1주차에는 포함 경로가 맞는지 확인한다.
      ls $(ros2 pkg prefix ur_simulation_gz)/share/ur_simulation_gz/urdf/
  흡착은 물리 마찰 대신 '고정 관절을 붙였다 떼는' 방식이다. 작은 나사를 마찰로 집으면 Gazebo 에서 미끄러지기 쉬워서
  4주 안에 안정화하기 어렵다고 판단했다 (docs/DECISIONS.md).
-->
<!-- Jazzy 3.9 ur_moveit.launch.py의 SRDF 이름(ur_type)과 일치시킨다. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg ur_type)">
  <xacro:include filename="$(find ur_simulation_gz)/urdf/ur_gz.urdf.xacro"/>

  <!--
    진공 컵 두 개 헤드 (11-17 가영, 성민 님 파일을 사용자 승인으로 수정): 원래 40x12 mm 직육면체 패드 → 둥근 진공 컵 2개.
    큰 컵은 tool0 에서 아래로  홀더(지름 16 mm) → 공기 관(지름 3 mm) → 주름형 진공 컵(지름 5 mm, 높이 6 mm). 나사용.
    링 컵은 홀더 아래 팔로 tool0 +X 12 mm. M8 너트용. 입술 두 겹(안 지름 9 mm, 바깥 12 mm) 사이 고리에만 진공.
    가운데 센터링 핀(지름 7.6 mm, 스프링)이 너트 구멍에 들어가 너트를 가운데로 맞춘다.
    핀은 모양만 보이고 충돌은 없음 (Gazebo 너트 모델에 구멍이 없어서). 두 컵 입술 끝 높이는 같다.
    전체 길이 pad_length 는 그대로 50 mm (config/sim.yaml 의 tool_length_m 과 맞출 것).
    컵 크기·위치는 object_spawner.SuctionLimits 의 cup_diameter, ring_*, pin_diameter 와 맞출 것.
    링크 이름 vacuum_pad 는 SRDF 충돌 설정 때문에 유지.
  -->
  <xacro:property name="pad_length" value="0.05"/>
  <xacro:property name="holder_length" value="0.036"/>
  <xacro:property name="cup_height" value="0.006"/>
  <xacro:property name="cup_radius" value="0.0025"/>
  <xacro:property name="ring_outer_radius" value="0.006"/>
  <xacro:property name="ring_offset" value="0.012"/>
  <xacro:property name="pin_radius" value="0.0038"/>
  <link name="vacuum_pad">
    <visual>
      <origin xyz="0 0 ${holder_length / 2}"/>
      <geometry><cylinder radius="0.008" length="${holder_length}"/></geometry>
    </visual>
    <visual>
      <origin xyz="0 0 ${(holder_length + pad_length - cup_height) / 2}"/>
      <geometry><cylinder radius="0.0015" length="${pad_length - cup_height - holder_length}"/></geometry>
    </visual>
    <visual>
      <origin xyz="0 0 ${pad_length - cup_height / 2}"/>
      <geometry><cylinder radius="${cup_radius}" length="${cup_height}"/></geometry>
    </visual>
    <visual>  <!-- 링 컵 = 홀더 옆 팔 → 관 → 링 컵 -->
      <origin xyz="0.010 0 ${holder_length - 0.002}"/>
      <geometry><box size="0.008 0.004 0.004"/></geometry>
    </visual>
    <visual>
      <origin xyz="${ring_offset} 0 ${(holder_length + pad_length - cup_height) / 2}"/>
      <geometry><cylinder radius="0.0015" length="${pad_length - cup_height - holder_length}"/></geometry>
    </visual>
    <visual>
      <origin xyz="${ring_offset} 0 ${pad_length - cup_height / 2}"/>
      <geometry><cylinder radius="${ring_outer_radius}" length="${cup_height}"/></geometry>
    </visual>
    <visual>  <!-- 센터링 핀 (입술 아래로 2 mm, 스프링으로 들어감). 충돌 없음 -->
      <origin xyz="${ring_offset} 0 ${pad_length + 0.001}"/>
      <geometry><cylinder radius="${pin_radius}" length="0.002"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 ${holder_length / 2}"/>
      <geometry><cylinder radius="0.008" length="${holder_length}"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 ${(holder_length + pad_length - cup_height) / 2}"/>
      <geometry><cylinder radius="0.0015" length="${pad_length - cup_height - holder_length}"/></geometry>
    </collision>
    <collision>
      <origin xyz="0 0 ${pad_length - cup_height / 2}"/>
      <geometry><cylinder radius="${cup_radius}" length="${cup_height}"/></geometry>
    </collision>
    <collision>  <!-- 링 컵 = 홀더 옆 팔 → 관 → 링 컵 -->
      <origin xyz="0.010 0 ${holder_length - 0.002}"/>
      <geometry><box size="0.008 0.004 0.004"/></geometry>
    </collision>
    <collision>
      <origin xyz="${ring_offset} 0 ${(holder_length + pad_length - cup_height) / 2}"/>
      <geometry><cylinder radius="0.0015" length="${pad_length - cup_height - holder_length}"/></geometry>
    </collision>
    <collision>
      <origin xyz="${ring_offset} 0 ${pad_length - cup_height / 2}"/>
      <geometry><cylinder radius="${ring_outer_radius}" length="${cup_height}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${pad_length / 2}"/>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="vacuum_joint" type="fixed">
    <parent link="tool0"/>
    <child link="vacuum_pad"/>
  </joint>

  <!-- 물체 슬롯 하나당 플러그인 하나. 슬롯 수 = config/sim.yaml 의 max_objects -->
  <xacro:macro name="vacuum_slot" params="k">
    <gazebo>
      <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
        <!-- tool0·vacuum_pad 는 고정 관절이라 URDF → SDF 변환 때 wrist_3_link 로 합쳐진다. 그래서 부모는 wrist_3_link -->
        <parent_link>wrist_3_link</parent_link>
        <child_model>obj_${k}</child_model>
        <child_link>link</child_link>
        <attach_topic>/vacuum/obj_${k}/attach</attach_topic>
        <detach_topic>/vacuum/obj_${k}/detach</detach_topic>
        <output_topic>/vacuum/obj_${k}/state</output_topic>
        <suppress_child_warning>true</suppress_child_warning>
      </plugin>
    </gazebo>
  </xacro:macro>
  <xacro:vacuum_slot k="0"/>
  <xacro:vacuum_slot k="1"/>
  <xacro:vacuum_slot k="2"/>
</robot>
