<?xml version="1.0"?>
<!--
  작업 셀: 바닥 + 격자 종이 자리(work_mat) + 분류 상자 2개. 로봇은 ur_sim_control.launch.py 가 world 원점에 스폰한다.
  아래 좌표는 config/sim.yaml 과 맞춰야 한다:
    work_mat 의 모서리(-X,-Y)  = work_plane_x, work_plane_y  (A4 297x210 mm 기준)
    <type>_bin 중심            = part_types 에서 같은 칸의 bin_x, bin_y (공구 종류를 늘리면 상자도 여기 추가)
  물리·스폰·장면 전달 시스템 플러그인은 world 파일을 직접 줄 때 빠지면 안 된다 (스폰은 UserCommands 가 처리).
-->
<sdf version="1.9">
  <world name="workcell">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 격자 종이 자리. 표시용이라 충돌 없음 (두께 1 mm 판에 물체가 걸리지 않게) -->
    <model name="work_mat">
      <static>true</static>
      <pose>0.4485 -0.045 0.0005 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.297 0.21 0.001</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      </link>
    </model>

    <model name="screw_bin">
      <static>true</static>
      <pose>0.0 0.45 0 0 0 0</pose>
      <link name="link">
        <collision name="floor"><pose>0 0 0.0025 0 0 0</pose><geometry><box><size>0.15 0.15 0.005</size></box></geometry></collision>
        <visual name="floor"><pose>0 0 0.0025 0 0 0</pose><geometry><box><size>0.15 0.15 0.005</size></box></geometry><material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material></visual>
        <collision name="wall_px"><pose>0.0725 0 0.03 0 0 0</pose><geometry><box><size>0.005 0.15 0.06</size></box></geometry></collision>
        <visual name="wall_px"><pose>0.0725 0 0.03 0 0 0</pose><geometry><box><size>0.005 0.15 0.06</size></box></geometry><material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material></visual>
        <collision name="wall_nx"><pose>-0.0725 0 0.03 0 0 0</pose><geometry><box><size>0.005 0.15 0.06</size></box></geometry></collision>
        <visual name="wall_nx"><pose>-0.0725 0 0.03 0 0 0</pose><geometry><box><size>0.005 0.15 0.06</size></box></geometry><material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material></visual>
        <collision name="wall_py"><pose>0 0.0725 0.03 0 0 0</pose><geometry><box><size>0.15 0.005 0.06</size></box></geometry></collision>
        <visual name="wall_py"><pose>0 0.0725 0.03 0 0 0</pose><geometry><box><size>0.15 0.005 0.06</size></box></geometry><material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material></visual>
        <collision name="wall_ny"><pose>0 -0.0725 0.03 0 0 0</pose><geometry><box><size>0.15 0.005 0.06</size></box></geometry></collision>
        <visual name="wall_ny"><pose>0 -0.0725 0.03 0 0 0</pose><geometry><box><size>0.15 0.005 0.06</size></box></geometry><material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="nut_bin">
      <static>true</static>
      <pose>0.0 -0.45 0 0 0 0</pose>
      <link name="link">
        <collision name="floor"><pose>0 0 0.0025 0 0 0</pose><geometry><box><size>0.15 0.15 0.005</size></box></geometry></collision>
        <visual name="floor"><pose>0 0 0.0025 0 0 0</pose><geometry><box><size>0.15 0.15 0.005</size></box></geometry><material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse></material></visual>
        <collision name="wall_px"><pose>0.0725 0 0.03 0 0 0</pose><geometry><box><size>0.005 0.15 0.06</size></box></geometry></collision>
        <visual name="wall_px"><pose>0.0725 0 0.03 0 0 0</pose><geometry><box><size>0.005 0.15 0.06</size></box></geometry><material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse></material></visual>
        <collision name="wall_nx"><pose>-0.0725 0 0.03 0 0 0</pose><geometry><box><size>0.005 0.15 0.06</size></box></geometry></collision>
        <visual name="wall_nx"><pose>-0.0725 0 0.03 0 0 0</pose><geometry><box><size>0.005 0.15 0.06</size></box></geometry><material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse></material></visual>
        <collision name="wall_py"><pose>0 0.0725 0.03 0 0 0</pose><geometry><box><size>0.15 0.005 0.06</size></box></geometry></collision>
        <visual name="wall_py"><pose>0 0.0725 0.03 0 0 0</pose><geometry><box><size>0.15 0.005 0.06</size></box></geometry><material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse></material></visual>
        <collision name="wall_ny"><pose>0 -0.0725 0.03 0 0 0</pose><geometry><box><size>0.15 0.005 0.06</size></box></geometry></collision>
        <visual name="wall_ny"><pose>0 -0.0725 0.03 0 0 0</pose><geometry><box><size>0.15 0.005 0.06</size></box></geometry><material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
