<?xml version="1.0"?>
<!--
  M8 너트(맞변 13 mm, 두께 6 mm)를 원기둥(반지름 6.5 mm)으로 단순화. 장축이 없어 각도는 쓰지 않는다.
  모델 원점 = 바닥면 중심.
-->
<sdf version="1.9">
  <model name="nut">
    <link name="link">
      <pose>0 0 0.003 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia><ixx>6.8e-8</ixx><iyy>6.8e-8</iyy><izz>1.06e-7</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.0065</radius><length>0.006</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.0065</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0.8 0.65 0.2 1</ambient><diffuse>0.8 0.65 0.2 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
